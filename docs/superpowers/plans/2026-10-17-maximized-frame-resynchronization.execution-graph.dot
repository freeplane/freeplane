digraph execution_graph {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#1e222a", fontcolor="#f0f3f6", color="#373e4c", fontname="Noto Sans"];
  edge [color="#3b82f6", fontcolor="#94a3b8", fontname="Noto Sans"];

  subgraph cluster_frame_resynchronization {
    label = "Maximized Frame Resynchronization Lane";
    style = rounded;
    color = "#3b82f6";
    fontcolor = "#3b82f6";
    fontname = "Noto Sans Bold";
    T_001 [label="Task 1: Add Work-Area Target Resolution\nAdvanced"];
    T_002 [label="Task 2: Bound Maximized Feedback and Preserve Lifecycle Behavior\nCapable"];
    T_001 -> T_002;
  }
}
