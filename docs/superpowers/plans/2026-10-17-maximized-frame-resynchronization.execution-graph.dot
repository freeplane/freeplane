digraph maximized_frame_resynchronization {
  rankdir=LR;
  node [shape=box, style=rounded];
  subgraph cluster_frame_resynchronization {
    label = "Frame Resynchronization Lane";
    T-001 [label="Task 1: Lock the Retained Work-Area and Maximized-Guard Contract\nStandard"];
    T-003 [label="Task 3: Register Frames and Refresh the Adapter Across Look-and-Feel Changes\nCapable"];
